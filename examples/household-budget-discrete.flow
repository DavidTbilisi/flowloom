# Household budget — a discrete monthly map, not an ODE.
# Cash changes once a month by exactly (pay - needs - wants). Wants creep toward
# a share of pay whenever the balance *feels* comfortable, and a review loop pulls
# them back — but it reads the card statement, which is two months old. Two
# policy switches and two scenarios show where the leverage is:
#   ▣ Scenario (under Plot) runs one; 'flowloom compare' tabulates them all.
stock Cash [GEL] = 1500

param pay      [GEL/month] = 6400
param needs    [GEL/month] = 4000
param wantsBase [GEL/month] = 1800    # what Wants return to when the review bites
param creepCap             = 0.45     # Wants drift toward this share of pay …
param creepRate            = 0.03     # … at this fraction of the gap per month
param cushion  [GEL]       = 2500     # creep only when the felt balance is above this
param target   [GEL]       = 8000     # the reserve the review loop wants to see
param k                    = 0.10     # review gain: how hard a shortfall pulls Wants down
param lag      [month]     = 2        # the statement arrives two months late

switch separate = off                 # pay savings first, spend from what's left (Profit First)
switch rule48   = off                 # 48-hour rule on impulse buys

stock Level [GEL/month] = 1800        # the Wants level — it ratchets
aux felt [GEL] = if(separate, max(0, Cash - target), Cash)
aux statement [GEL] = delay_fixed(Cash, lag)            # what the review reads
aux shortfall = min(1, max(0, target - statement) / target)
aux creep  [GEL/month^2] = if(felt > cushion, creepRate * (creepCap * pay - Level), 0)   # a rate's rate
aux review [GEL/month^2] = k * (wantsBase * (1 - 0.35 * shortfall) - Level)
change(Level) = creep + review

aux impulse [GEL/month] = (if(t % 9 == 5, 450, 0) + if(t % 4 == 2, 300, 0)) * if(rule48, 0.3, 1)
aux wants [GEL/month] = max(0, Level) + impulse
aux lastMonth [GEL] = previous(Cash)                    # for the plot: last month's balance
flow net [GEL/month] = pay - needs - wants
change(Cash) = net

scenario safe     separate=on rule48=on
scenario recovery separate=on pay=9000 Cash=5000

sim dt=1 to=36 method=euler timeunit=month
plot Cash wants lastMonth
